{
  "name": "abdelmalek-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Abdelmalek Studio — موقع static (HTML/CSS/JS) + لوحة إدارة محلية. من غير framework ولا سيرفر: الموقع بيشتغل مباشرة من site/، و tools/build.js بيبني dist/ (نسخة النشر + ملفات SEO) لـ GitHub Pages.",
  "scripts": {
    "test": "node tests/run-all.js",
    "test:install": "playwright install chromium",
    "seo": "node tools/seo.js",
    "check:js": "node tools/check-syntax.js",
    "check:links": "node tools/check-links.js",
    "test:quick": "node tests/run-all.js --quick",
    "test:e2e": "node tests/e2e.js",
    "build": "node tools/build.js",
    "yt-titles": "node tools/fetch-yt-titles.js"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
